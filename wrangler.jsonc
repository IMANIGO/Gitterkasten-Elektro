{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitterkasten-elektro",
  // Set this to today's date
  "compatibility_date": "2026-11-20",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "gitterkasten.imanigo.de",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
