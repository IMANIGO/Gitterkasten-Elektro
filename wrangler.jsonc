{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitterkasten-elektro",
  // Set this to today's date
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
